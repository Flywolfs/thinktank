# 情报 Planner Docker — 专用配置（复制为 .env 并填入真实值）
#
# ⚠️ 这是给 Docker 容器专用的 DeepSeek API key —— 不要使用宿主机 ~/.hermes/.env 里的 key
#    创建一个新的 key: https://platform.deepseek.com/api_keys
#
# DeepSeek 专用 API key（容器内 Hermes 用）
DEEPSEEK_API_KEY=sk-你的新key

# API Server 访问 key（think_tank 系统调用容器 API 时的 Bearer token）
HERMES_INTEL_API_KEY=openssl-rand-hex-32
