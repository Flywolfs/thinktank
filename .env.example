# ============================================================
# 智库情报系统 — 环境变量配置
# ============================================================
# 复制此文件为 .env 并填入实际的 Key：
#   cp .env.example .env
# ============================================================

# ── 搜索引擎 ──────────────────────────────────────────

# Serper.dev — Google 搜索（推荐首选）
# 获取: https://serper.dev → 注册 → Dashboard → API Key
SERPER_API_KEY=

# SerpApi — 百度搜索（中文实体刚需）
# 获取: https://serpapi.com → 注册 → Dashboard → API Key
SERPAPI_API_KEY=

# Bing Search API — 免费备用
# 获取: https://portal.azure.com → 创建 Bing Search 资源 → Keys and Endpoint
# 免费层 1000次/月
BING_API_KEY=


# ── 社交媒体 Cookie（MediaCrawler 用）──────────────────

# 获取方法: bb-browser 登录平台后 → F12 → Application → Cookies → 复制 Cookie 字符串
# 知乎
ZHIHU_COOKIE=
# 小红书
XHS_COOKIE=
# 微博
WEIBO_COOKIE=


# ── LLM ────────────────────────────────────────────────

# DeepSeek API（推荐，已有账号）
# 获取: https://platform.deepseek.com → API Keys
DEEPSEEK_API_KEY=

# 可选：火山引擎豆包 API（联网搜索 + 推理）
# 获取: https://console.volcengine.com/ark → API Keys
DOUBAO_API_KEY=


# ── Plan Provider（P0.3 融合方案）──────────────────────

# 模式: auto(默认, Hermes优先失败降级) | hermes(强制) | local(仅自研)
PLAN_PROVIDER=auto

# Docker Hermes Agent (intel-planner profile) API
# key 与 deploy/intel-planner/.env 的 HERMES_INTEL_API_KEY 一致
HERMES_API_URL=http://localhost:8643
HERMES_API_KEY=
HERMES_PLAN_MODEL=intel-planner
HERMES_PLAN_TIMEOUT=300
# 动态工具生成轮询上限（Hermes 写文件可能多次迭代，独立于 HTTP timeout）
HERMES_POLL_TIMEOUT=300

# 动态工具审批模式: auto(默认,LLM安全审查自动通过,发现问题反馈Hermes修改) / manual(人工审阅)
DYNAMIC_TOOL_APPROVAL=auto


# ── ASR ────────────────────────────────────────────────

# Qwen3-ASR 服务地址（默认本地 Docker）
# Docker: ~/Documents/youtube_download/docker-compose.yml
QWEN3_ASR_URL=http://localhost:8000


# ── 数据库 ──────────────────────────────────────────────

# Neo4j 知识图谱
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# PostgreSQL 结构化数据
DATABASE_URL=postgresql://thinktank:@localhost:5432/thinktank

# Redis 缓存/队列
REDIS_URL=redis://localhost:6379/0


# ── RSSHub（备用，目前 B站 已改用 bilibili-cli）───────

# 自部署 RSSHub 地址
# docker run -d --name rsshub -p 1200:1200 diygod/rsshub:chromium-bundled
RSSHUB_URL=http://localhost:1200
